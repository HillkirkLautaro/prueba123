# ============================================================
# Variables de entorno del proyecto (TP Integrador N.º 1)
-- Copia este archivo a .env y completa con tus valores reales.
-- ⚠️ NUNCA subas el archivo .env al repositorio (ya está en .gitignore).
-- Las claves y contraseñas van solo en el panel del proveedor (InfinityFree).
-- ============================================================

# Base de datos (MySQL en la nube - InfinityFree)
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_NAME=tu_base_de_datos
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña

# Entorno de la aplicación
APP_ENV=production

# hCaptcha (anti-bot en formularios) - usado desde backend y frontend
HCAPTCHA_SITEKEY=tu_sitekey
HCAPTCHA_SECRET=tu_secret

# Google OAuth (opcional - login con Google)
GOOGLE_CLIENT_ID_OAUTH=tu_client_id
GOOGLE_SECRET_CLIENT=tu_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://tudominio.com/google_callback.php

# ============================================================
# Resend - servicio de email transaccional (llamado desde BACKEND)
# ⚠️ Pon aquí tu API key de Resend. Esta es la única clave que debes agregar.
# ============================================================
RESEND_API_KEY=re_tu_api_key_de_resend

# Orígenes permitidos para validación de peticiones (CORS/origen)
ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com
